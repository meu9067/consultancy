<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="container contact__inner">
    <h2 id="contact-title">Let's make your product accessible</h2>
    <p>
      Whether you need an audit, hands-on remediation, or training for your
      team, I'd love to hear about your project.
    </p>
    <div class="contact__actions">
      <a class="button button--primary" href="mailto:{{email}}">
        Email {{email}}
      </a>
      <a
        class="button button--ghost"
        href="{{linkedin}}"
        target="_blank"
        rel="noopener noreferrer"
      >
        Connect on LinkedIn
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
      <a
        class="button button--ghost"
        href="{{github}}"
        target="_blank"
        rel="noopener noreferrer"
      >
        View on GitHub
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
    </div>
  </div>
</section>
