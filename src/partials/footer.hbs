<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>&copy; <span id="current-year">2025</span> {{name}}. {{footer.rights}}</p>
    <p class="site-footer__note">
      {{footer.noteBefore}}
      <a href="{{backgroundPhotoCredit}}" target="_blank" rel="noopener noreferrer"
        >{{footer.noteLinkText}}<span class="visually-hidden"> {{contact.newTabSuffix}}</span></a
      >.
    </p>
    <nav class="site-footer__links" aria-label="Legal">
      <a href="{{localePrefix}}/accessibility-statement.html">{{footer.accessibilityStatement}}</a>
      <a href="{{localePrefix}}/privacy.html">{{footer.privacyPolicy}}</a>
      <a href="{{github}}" target="_blank" rel="noopener noreferrer"
        >{{footer.sourceOnGitHub}}<span class="visually-hidden"> {{contact.newTabSuffix}}</span></a
      >
    </nav>
  </div>
</footer>
