<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__inner">
    <p class="hero__eyebrow">Front-End Accessibility Consultancy</p>
    <h1 id="hero-title" class="hero__title">
      Making the web usable for <span class="highlight">everyone</span>.
    </h1>
    <p class="hero__lead">{{tagline}}</p>
    <p class="hero__meta">
      {{yearsExperience}}+ years of hands-on front-end and accessibility experience.
    </p>
    <div class="hero__actions">
      <a class="button button--primary" href="#contact">Get in touch</a>
      <a class="button button--ghost" href="#services">See services</a>
    </div>
  </div>
</section>
