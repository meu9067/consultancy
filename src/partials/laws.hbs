<section id="laws" class="laws" aria-labelledby="laws-title">
  <div class="container">
    <h2 id="laws-title">{{laws.title}}</h2>
    <p class="laws__intro">
      {{laws.intro}}
    </p>
    <div class="laws__grid">
      {{#each lawsList}}
      <article class="laws__card">
        <h3>{{title}}</h3>
        <p>{{description}}</p>
      </article>
      {{/each}}
    </div>
  </div>
</section>
