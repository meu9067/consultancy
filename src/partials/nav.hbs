<header class="site-nav">
  <div class="container site-nav__inner">
    <a class="site-nav__brand" href="{{localePrefix}}/#main-content">{{name}}</a>
    <div class="site-nav__group">
      <div class="language-switcher" role="group" aria-label="{{languageSwitcherLabel}}">
        <a
          class="language-switcher__link{{#unless localePrefix}} is-current{{/unless}}"
          href="{{enHref}}"
          {{#unless localePrefix}}aria-current="true"{{/unless}}
          >EN</a
        >
        <a
          class="language-switcher__link{{#if localePrefix}} is-current{{/if}}"
          href="{{ptHref}}"
          {{#if localePrefix}}aria-current="true"{{/if}}
          >PT</a
        >
      </div>
      <button
        class="theme-toggle"
        type="button"
        id="theme-toggle"
        aria-pressed="false"
        data-label-dark="{{themeToggleDark}}"
        data-label-light="{{themeToggleLight}}"
      >
        <span class="theme-toggle__icon" aria-hidden="true">🌙</span>
        <span class="theme-toggle__label">{{themeToggleDark}}</span>
      </button>
      <nav aria-label="Primary">
        <button
          class="site-nav__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="primary-menu"
        >
          <span class="visually-hidden">{{toggleMenuLabel}}</span>
          <span aria-hidden="true">☰</span>
        </button>

      </nav>
    </div>
  </div>
</header>
