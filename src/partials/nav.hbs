<header class="site-nav">
  <div class="container site-nav__inner">
    <a class="site-nav__brand" href="/#main-content">{{name}}</a>
    <div class="site-nav__group">
      <button
        class="theme-toggle"
        type="button"
        id="theme-toggle"
        aria-pressed="false"
      >
        <span class="theme-toggle__icon" aria-hidden="true">🌙</span>
        <span class="theme-toggle__label">Dark mode</span>
      </button>
      <nav aria-label="Primary">
        <button
          class="site-nav__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="primary-menu"
        >
          <span class="visually-hidden">Toggle navigation menu</span>
          <span aria-hidden="true">☰</span>
        </button>
        <ul id="primary-menu" class="site-nav__list">
          <li><a href="/#about">About</a></li>
          <li><a href="/#laws">Why It Matters</a></li>
          <li><a href="/#services">Services</a></li>
          <li><a href="/#faq">FAQ</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </nav>
    </div>
  </div>
</header>
